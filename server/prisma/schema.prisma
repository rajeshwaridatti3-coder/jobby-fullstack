generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  savedJobs    SavedJob[]
  applications Application[]
  recentViews  RecentView[]
}

model Job {
  id                 String        @id @default(cuid())
  title              String
  company            String
  companyLogo        String?
  location           String
  employmentType     EmploymentType
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String        @default("INR")
  experience         String?
  rating             Float?
  description        String
  requirements       String[]
  skills             String[]
  companyWebsite     String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  savedBy            SavedJob[]
  applications       Application[]
  recentViews        RecentView[]

  @@index([title])
  @@index([company])
  @@index([location])
  @@index([employmentType])
  @@index([createdAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  status      ApplicationStatus @default(APPLIED)
  notes       String?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status])
}

model RecentView {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, viewedAt])
}
